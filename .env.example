ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Points at a locally-installed PostgreSQL (not the Docker one — see README.md's "Database"
# section for how brfid_user / brfid_platform were created on the native install).
# If you use the Dockerized Postgres instead (see the commented `db` service in
# docker-compose.yml), change DATABASE_PORT to 5432.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=brfid_platform
DATABASE_USER=brfid_user
DATABASE_PASSWORD=brfid_password
# DATABASE_URL=postgresql+psycopg2://brfid_user:brfid_password@localhost:5433/brfid_platform
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

TEST_DATABASE_URL=postgresql+psycopg2://brfid_user:brfid_password@localhost:5433/brfid_platform_pytest

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_TTL_HOURS=1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173

FILES_STORAGE_BACKEND=seaweedfs
SEAWEEDFS_FILER_URL=http://localhost:8889
FILES_LOCAL_DIR=./uploads
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=

RATE_LIMIT_PER_MINUTE=120
